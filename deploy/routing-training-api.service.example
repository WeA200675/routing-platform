[Unit]
Description=Routing Training API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/routing-platform
EnvironmentFile=/home/ubuntu/routing-platform/deploy/training-api.env
Environment=TRAINING_STATE_PATH=/var/lib/routing-training/api-state.json
ExecStart=/usr/bin/python3 /home/ubuntu/routing-platform/backend/training_api.py
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
